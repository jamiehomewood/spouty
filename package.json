{
  "name": "spouty",
  "productName": "Spouty",
  "version": "1.0.0",
  "description": "Renders a web page offscreen and sends it over Spout (replaces OBS + Spout plugin for the Igloo room).",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . Spouty --platform=win32 --arch=x64 --out=dist --overwrite --no-asar --ignore=^/dist --ignore=^/build-tools"
  },
  "devDependencies": {
    "electron": "38.8.0",
    "@electron/packager": "^18.3.6"
  }
}
